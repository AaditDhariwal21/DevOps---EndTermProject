# Rendered at container start by the Nginx image's envsubst step:
#   /etc/nginx/templates/default.conf.template -> /etc/nginx/conf.d/default.conf
# ${BACKEND_URL} is the only substituted variable (compose: http://backend:8000,
# Kubernetes: http://<release>-backend:8000).

server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    server_tokens off;
    include /etc/nginx/security-headers.conf;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;

    # Probe endpoint for Docker/Kubernetes — never touches the backend.
    location = /nginx-health {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # Browser calls /api/* on the same origin; Nginx forwards them to FastAPI.
    location /api/ {
        proxy_pass ${BACKEND_URL};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 30s;
    }

    # Swagger UI through the same origin (handy for the demo).
    location ~ ^/(docs|redoc|openapi\.json)$ {
        proxy_pass ${BACKEND_URL};
        proxy_set_header Host $host;
    }

    # Fingerprinted build assets can be cached forever.
    location /assets/ {
        expires 1y;
        include /etc/nginx/security-headers.conf;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # SPA fallback: unknown paths serve index.html (never cached, so new deploys show up).
    location / {
        include /etc/nginx/security-headers.conf;
        add_header Cache-Control "no-cache";
        try_files $uri $uri/ /index.html;
    }
}
