# Copy to terraform.tfvars and adjust. terraform.tfvars is git-ignored.
# Never put AWS access keys here — Terraform reads credentials from the
# AWS CLI profile / environment (aws configure, AWS_PROFILE, or aws sso login).

region       = "ap-southeast-2"
project_name = "deskflow"
environment  = "dev"

vpc_cidr = "10.0.0.0/16"
az_count = 2

cluster_version     = "1.35"
node_instance_types = ["m7i-flex.large"] # Free Tier eligible (Free plan accounts reject t3.medium)
node_desired_size   = 2
node_min_size       = 2
node_max_size       = 3

# Other IAM users/roles that should get kubectl admin (optional)
cluster_admin_arns = [
  # "arn:aws:iam::123456789012:user/teammate",
]

# Keyless GitHub Actions deploys via OIDC. Format: "owner/repo".
# Leave empty if your AWS Organization blocks IAM OIDC providers (iam:CreateOpenIDConnectProvider);
# CI then deploys with access keys stored as GitHub secrets (see README §5).
github_repository = ""

# Set to false if your AWS account already has the GitHub OIDC provider.
create_github_oidc_provider = true
